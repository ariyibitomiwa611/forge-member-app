# Copy to .env.local for local development. In AWS Amplify, add these under
# App settings → Environment variables instead.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: where "Message your coach" sends members (opens their email app)
VITE_COACH_EMAIL=
